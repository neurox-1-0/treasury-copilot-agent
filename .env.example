# ==============================================================================
# Treasury Copilot Agent — Environment Configuration
# ==============================================================================

# Database Connection (Supports SQLite or PostgreSQL out of the box)
# For SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///agent_audit.db

# For PostgreSQL (production/cloud database):
# DATABASE_URL=postgresql://user:password@localhost:5432/treasury_copilot

# LLM Configuration
# GEMINI_MODEL: Model to use for generating rationale text (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# User Governance & RBAC Configuration (JSON array of users)
# USERS_CONFIG=[{"username":"analyst1","password_hash":"<sha256>","role":"ANALYST","display_name":"Analyst"},{"username":"admin1","password_hash":"<sha256>","role":"ADMIN","display_name":"Admin"}]

# Mock Services & Webhooks
BANK_MOCK_URL=http://localhost:8002
ERP_MOCK_URL=http://localhost:8001
NOTIFICATION_WEBHOOK_URL=http://localhost:9000/webhook
